[0m13:13:23.280960 [debug] [Thread-1 (]: On model.public_ipeds.stg_seed__cip_codes: /* {"app": "dbt", "dbt_version": "1.11.7", "profile_name": "public_ipeds", "target_name": "dev", "node_id": "model.public_ipeds.stg_seed__cip_codes"} */


  create or replace view `data-eng-ipeds`.`dbt_echristiansen`.`stg_seed__cip_codes`
  OPTIONS()
  as with 

cip_codes as (
    select * from `data-eng-ipeds`.`dbt_echristiansen`.`cipcode2020`
),

rename as (
    select
        CIPCode         as cip_code,  -- primary key
        CIPFamily       as cip_family,
        CIPTitle        as cip_title,
        CIPDefinition   as cip_definition,
        -- Uses Department of Homeland Security (DHS) definition of STEM fields
        case 
            when substr(CIPCode, 0, 2) in ('14', '26', '27', '40') then true
            else false
        end             as is_stem,
        -- Flag CIP family rows
        case instr(CIPCode, '.')
            when 0 then true
            else false
        end             as is_cip_family
    from cip_codes

    union all
    
    -- Add residual codes not in official CIP file
    select
        '99'        as cip_code,
        '99'        as cip_family,
        'RESIDUAL'  as cip_title,
        'Residual code not in official CIP file' as cip_definition,
        false       as is_stem,
        true        as is_cip_family
    
    union all
    
    select
        '99.0000'   as cip_code,    
        '99'        as cip_family,
        'Residual'  as cip_title,
        'Residual code not in official CIP file' as cip_definition,
        false       as is_stem,
        false       as cip_family_indicator

)

select * from rename;


